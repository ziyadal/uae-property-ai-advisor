# Required
OPENAI_API_KEY=replace_with_your_key

# Optional model and retrieval settings
BROKER_MODEL=gpt-5.2-2025-12-11
CONSTRAINT_EXTRACTOR_MODEL=gpt-4.1-mini
ENABLE_LLM_CONSTRAINT_EXTRACTION=0
KB_RETRIEVER_K=4
FORCE_REINDEX=0

# Local generated-data locations
KB_DB_NAME=vector_db
PROPERTY_DB_NAME=property_vector_db
PROPERTY_COLLECTION_NAME=property_listings
PROPERTY_SEED_CSV=data/properties_seed.csv
PROPERTY_SEED_COUNT=40
PROPERTY_SEED_RANDOM=42

# Set to 1 only when you intentionally want a public Gradio share link
GRADIO_SHARE=0
